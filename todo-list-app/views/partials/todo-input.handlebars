<form hx-post="/todos" hx-target="body" hx-swap="innerHTML transition:true">
  <input type="hidden" name="filter" value="{{this.selectedFilter}}" />
  <input
    type="text"
    name="todo"
    required
    minlength="5"
    placeholder="What's in your mind?"
    class="block w-full rounded-lg p-4 text-black text-2xl"
    autofocus
  />
  <button
    hx-disabled-elt="this"
    type="submit"
    class="block w-1/2 mx-auto p-2 rounded-lg text-xl mt-5 bg-amber-500 uppercase font-bold hover:bg-amber-600 transition-all hover:shadow-lg hover:translate-y-1"
  >Add Todo</button>
  <div
    id="request-indicator"
    class="flex items-center my-indicator justify-center my-8"
  >
    <img
      src="assets/bars.svg"
      alt="Loading indicator"
      class="h-12 w-12 mx-auto"
    />
  </div>
</form>