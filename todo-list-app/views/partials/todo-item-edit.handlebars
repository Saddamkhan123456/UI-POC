<div id="todo-edit-{{this.id}}">
  <form
    hx-put="/todos/{{this.id}}"
    hx-target="#todo-edit-{{this.id}}"
    hx-swap="outerHTML transition:true"
    class="flex items-center mb-4 justify-between gap-4"
  >
    <input
      type="text"
      value="{{this.name}}"
      class="w-3/4 rounded-sm text-black p-1"
      name="name"
    />
    <button
      type="submit"
      class="p-2 border-2 text-sm border-amber-500 rounded-md uppercase transition-all font-bold hover:bg-indigo-400 mr-2 hover:scale-105 w-1/4"
    > Save</button>
    <button
      hx-get="/todos/{{this.id}}?filter={{this.selectedFilter}}"
      hx-target="#todo-edit-{{this.id}}"
      hx-swap="outerHTML transition:true"
      type="submit"
      class="border-2 text-sm border-neutral-500 p-2 rounded-md uppercase font-bold transition-all hover:bg-indigo-400 mr-2 hover:scale-105 w-1/4"
    >Cancel</button>
  </form>
</div>